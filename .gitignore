# Python и инструменты разработки
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
venv/
.venv/

# Локальные настройки и секреты
configs/*.yaml*
configs/*.yml*
!configs/*.yaml.example
!configs/*.yml.example
.env
.env.*
*.env
*.env.*
*.token
*.secrets.*
*.pem
*.key
*.pfx
*.p12
*.p8

# Рабочие данные, журналы и почтовые выгрузки
logs/*
!logs/.gitkeep
*.log
*.jsonl
*.eml
*.mbox
*.pst
*.ost
*.db
*.sqlite
*.sqlite3
*.tmp
*.bak
*.swp
~$*

# Редакторы и операционная система
.idea/
.vscode/
.DS_Store
Thumbs.db
